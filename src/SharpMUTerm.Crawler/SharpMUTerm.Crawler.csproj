<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpMUTerm.Crawler</RootNamespace>
    <AssemblyName>sharpmuterm-mssp-crawler</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Core only, and deliberately nothing else. The crawler reuses TcpTransport/TelnetSession and the
      MSSP model; it must never pull in SharpMUTerm.Tui or SharpConsoleUI, because a headless tool that
      drags a TUI framework behind it cannot be run anywhere a TUI cannot.
    -->
    <ProjectReference Include="..\SharpMUTerm.Core\SharpMUTerm.Core.csproj" />
  </ItemGroup>

</Project>
