<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpMUTerm.Tui</RootNamespace>
    <AssemblyName>sharpmuterm</AssemblyName>

    <!--
      Runtimes we ship single-file builds for. Declaring them here is build-safe (only used on
      `dotnet publish -r <rid>`); the single-file/self-contained knobs live in the publish
      profiles under Properties/PublishProfiles so they never affect `dotnet build`/`run`.
      See docs/PACKAGING.md.
    -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    SharpConsoleUI comes from NuGet by default. Clone the framework beside this repo
    (`git clone https://github.com/nickprotop/ConsoleEx.git ../../SharpConsoleUI`, checked out at the
    tag matching Directory.Packages.props) and it is referenced from source instead — so you can read
    and step into the framework rather than decompiling it. CI and anyone without the clone are
    unaffected: the condition simply doesn't match and the package is used.
    Set UseSharpConsoleUIPackage=true to force the package even with the clone present.
  -->
  <PropertyGroup>
    <SharpConsoleUISource>$(MSBuildThisFileDirectory)..\..\..\SharpConsoleUI\SharpConsoleUI\SharpConsoleUI.csproj</SharpConsoleUISource>
    <UseSharpConsoleUISource Condition="'$(UseSharpConsoleUIPackage)' != 'true' AND Exists('$(SharpConsoleUISource)')">true</UseSharpConsoleUISource>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseSharpConsoleUISource)' == 'true'">
    <ProjectReference Include="$(SharpConsoleUISource)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSharpConsoleUISource)' != 'true'">
    <PackageReference Include="SharpConsoleUI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpMUTerm.Tui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMUTerm.Core\SharpMUTerm.Core.csproj" />
    <ProjectReference Include="..\SharpMUTerm.Graphics\SharpMUTerm.Graphics.csproj" />
    <ProjectReference Include="..\SharpMUTerm.Scripting\SharpMUTerm.Scripting.csproj" />
    <ProjectReference Include="..\SharpMUTerm.Web\SharpMUTerm.Web.csproj" />
  </ItemGroup>

</Project>
