<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MuClient.Tui</RootNamespace>
    <AssemblyName>muglyph</AssemblyName>
    <!--
      Terminal.Gui v2 is a prerelease mid-migration from the static Application facade to an
      instance-based IApplication. We use the current (static) surface deliberately; suppress the
      "legacy Application is going away" obsoletion until the replacement API stabilises.
    -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>

    <!--
      Runtimes we ship single-file builds for. Declaring them here is build-safe (only used on
      `dotnet publish -r <rid>`); the single-file/self-contained knobs live in the publish
      profiles under Properties/PublishProfiles so they never affect `dotnet build`/`run`.
      See docs/PACKAGING.md.
    -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MuClient.Core\MuClient.Core.csproj" />
    <ProjectReference Include="..\MuClient.Graphics\MuClient.Graphics.csproj" />
    <ProjectReference Include="..\MuClient.Scripting\MuClient.Scripting.csproj" />
  </ItemGroup>

</Project>
